class Solution {
public:
    ListNode* reverseKGroup(ListNode* head, int k) {

        if(head == NULL || k == 1) return head;

        
        int len = 0;
        ListNode* temp = head;
        while(temp != NULL) {
            len++;
            temp = temp->next;
        }

        
        ListNode* dummy = new ListNode(0);
        dummy->next = head;

        ListNode* prevGroup = dummy;

        while(len >= k) {

           
            ListNode* curr = prevGroup->next;
            ListNode* next = curr->next;

            for(int i = 1; i < k; i++) {
                curr->next = next->next;
                next->next = prevGroup->next;
                prevGroup->next = next;
                next = curr->next;
            }

            prevGroup = curr;
            len -= k;
        }

        return dummy->next;
    }
};
