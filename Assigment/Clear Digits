class Solution {
public:
    string clearDigits(string s) {

        string ans = "";

        for(char ch : s) {

            if(isdigit(ch)) {
                if(!ans.empty())
                    ans.pop_back();   // remove closest left letter
            }
            else {
                ans.push_back(ch);   // keep letter
            }
        }

        return ans;
    }
};
